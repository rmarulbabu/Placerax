# ===== Application =====
ENV=development
APP_NAME=Placera
API_V1_PREFIX=/api/v1
DEBUG=true

# ===== Security / JWT =====
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== MongoDB (local or Atlas) =====
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
# NOTE: if your password has special chars (@ : / ?), URL-encode them (@ -> %40)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=placera

# ===== File storage (optional) =====
# Leave blank to use a local stub. Fill in to enable real Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== CORS (comma-separated) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Seed admin (created by app.scripts.seed) =====
SEED_ADMIN_EMAIL=admin@placera.io
SEED_ADMIN_PASSWORD=Admin@12345
